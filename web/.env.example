# EcoCollect SJ - Web Administration Portal Firebase Environment Config

# Set to true to test against local Firebase Emulator Suite (Port 8080/9099)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# Production Firebase Project Credentials (from Firebase Console > Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=ecocollect-sj.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=ecocollect-sj
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=ecocollect-sj.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id_here
