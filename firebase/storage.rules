rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role in ['menro_admin', 'sys_admin', 'barangay_official', 'collector']
      );
    }

    // Citizen Complaint Photos:
    // Residents can upload photos up to 5MB (images only)
    // Photos can be viewed by the uploading resident or municipal staff
    match /complaints/{complaintId}/{photoFile} {
      allow read: if isStaffOrAdmin() || isAuthenticated();
      allow write: if isAuthenticated()
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth.token.role in ['menro_admin', 'sys_admin'];
    }

    // Official Verification Documents / Executive Orders:
    // Publicly readable, writeable only by MENRO / SysAdmin
    match /official_docs/{documentFile} {
      allow read: if true;
      allow write: if request.auth.token.role in ['menro_admin', 'sys_admin']
                   && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
